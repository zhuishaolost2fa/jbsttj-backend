# ============================================================
# 应用基础配置
# ============================================================
APP_NAME=File Upload Service
APP_ENV=development            # development | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# 允许跨域的前端来源，逗号分隔；生产环境不要用 *
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000

# ============================================================
# Supabase
# ============================================================
# 项目地址，形如 https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# anon key：仅用于代理登录/注册接口（前端也可直接使用）
SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# service_role key：后端写库用，会绕过 RLS，**严禁泄露到前端**
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# JWT 校验方式二选一：
# 1) 传统 HS256：填 Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
# 2) 新版非对称密钥(ES256/RS256)：留空 SUPABASE_JWT_SECRET，会自动拉取 JWKS 校验
SUPABASE_JWKS_URL=
# 校验 aud，Supabase 默认签发 authenticated
SUPABASE_JWT_AUDIENCE=authenticated

# ============================================================
# 阿里云 OSS
# ============================================================
OSS_ACCESS_KEY_ID=LTAI5t...
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
# 公网 endpoint，例如 oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# V4 签名必填，例如 cn-hangzhou
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket-name
# 签名版本：v4(推荐) | v1
OSS_SIGNATURE_VERSION=v4
# 若服务部署在同地域 ECS，可填内网 endpoint 走内网流量（免费且更快）
OSS_INTERNAL_ENDPOINT=
# 绑定的自定义域名/CDN，填了之后下载链接会用它
OSS_CDN_DOMAIN=
OSS_USE_CNAME=false

# ---- STS 临时凭证接入（可选，推荐用于生产）----
# 开启后，服务端用下方长期 AccessKey 调用 STS AssumeRole 扮演 OSS_STS_ROLE_ARN，
# 拿到短期临时凭证访问 OSS；长期密钥永不下发到浏览器。
# 留空 OSS_STS_ACCESS_KEY_ID/SECRET 时会复用上方的 OSS_ACCESS_KEY_ID/SECRET。
OSS_USE_STS=false
OSS_STS_ROLE_ARN=acs:ram::123456789012****:role/oss-upload-role
OSS_STS_ACCESS_KEY_ID=
OSS_STS_ACCESS_KEY_SECRET=
OSS_STS_SESSION_NAME=file-upload-service
OSS_STS_DURATION_SECONDS=3600
OSS_STS_ENDPOINT=sts.aliyuncs.com

# ============================================================
# 上传策略
# ============================================================
# 对象 key 前缀
UPLOAD_PREFIX=uploads
# 默认分片大小 (字节)，OSS 要求除最后一片外每片 >= 100KB，推荐 5MB
UPLOAD_CHUNK_SIZE=5242880
# 单文件最大体积 (字节)，默认 5GB
MAX_FILE_SIZE=5368709120
# 最大分片数，OSS 硬上限 10000
MAX_PART_COUNT=10000
# 分片预签名 URL 有效期 (秒)
PRESIGN_EXPIRE_SECONDS=3600
# 下载签名 URL 有效期 (秒)
DOWNLOAD_URL_EXPIRE_SECONDS=1800
# 单次请求最多批量签发多少个分片 URL
MAX_PRESIGN_BATCH=200
# 允许的扩展名，逗号分隔；留空表示不限制
ALLOWED_EXTENSIONS=
# 禁止的扩展名（黑名单优先级高于白名单）
BLOCKED_EXTENSIONS=exe,bat,cmd,sh,com,scr,msi,dll,jar

# ============================================================
# 服务间调用（可选）
# ============================================================
# 填写后可用 X-API-Key 头以 service 身份调用接口，留空则关闭该通道
SERVICE_API_KEY=

# ============================================================
# DM 主持人手册 RAG 流水线（可选，填齐后自动启用）
# ============================================================
# 启用判据（缺任一即视为未启用，接口明确报错而不是静默失败）：
#   SILICONFLOW_API_KEY + SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   + CELERY_BROKER_URL + CELERY_RESULT_BACKEND
# 即只需再补下面两组：硅基流动密钥、以及 Celery broker/backend。

# ---- 硅基流动（SiliconFlow，OpenAI 兼容协议；chat 与 embedding 共用 base_url）----
SILICONFLOW_API_KEY=
# 对话模型：生成问答对用；默认 Qwen2.5-72B-Instruct
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# 向量模型：BAAI/bge-large-zh-v1.5 固定 1024 维，改模型必须同步改 SQL 里的 vector(N)
SILICONFLOW_EMBED_MODEL=BAAI/bge-large-zh-v1.5
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 单次 embeddings 批量上限（接口超过会 400）；worker 内 LLM 并发上限（防 429）
EMBEDDING_BATCH_SIZE=32
# 单条文本送 embedding 前的字符上限。bge-large-zh-v1.5 的 token 上限约 512，
# 硅基流动对超长输入直接 400（不服务端截断），故客户端按字符预留余量截断。
EMBEDDING_MAX_CHARS=480
LLM_MAX_CONCURRENCY=4

# ---- Celery：broker 走 RabbitMQ，result backend 走 Redis ----
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# 去重指纹的全局集合也放 Redis，跨 shard / 跨任务共享
CELERY_REDIS_URL=redis://127.0.0.1:6379/1
# 单任务软/硬超时（秒）；长任务 prefetch 必须设 1；eager=true 时任务同步执行（测试用）
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800
CELERY_WORKER_PREFETCH=1
CELERY_EAGER=false

# ---- DM 手册解析参数（一般无需改动）----
DM_EXTRACT_PAGES_PER_SHARD=20     # 每个提取任务负责的页数
DM_CHUNK_SIZE=800                 # 粗分块目标字符数
DM_CHUNK_OVERLAP=120             # 粗分块重叠
DM_SEMANTIC_SPLIT_THRESHOLD=1600 # 超过该长度的粗块才做语义细分
DM_SEMANTIC_BREAKPOINT_PERCENTILE=88  # 语义断点分位数，越大切得越少
DM_MIN_CHUNK_CHARS=40            # 短于该长度的块直接丢弃（残留页码等）
DM_SIMHASH_THRESHOLD=3           # SimHash 汉明距离阈值，<= 判为近似重复

# ---- 阿里云 OCR（文字识别，处理扫描件 / 图片型 PDF）----
# 默认复用 OSS 的 AccessKey（同账号），无需单独申请密钥。
# 但必须在阿里云控制台「开通文字识别服务」(产品名：文字识别 / ocr-api) 后才能调用，
# 否则扫描件会被流水线判为「纯扫描件需要 OCR」并跳过 OCR 兜底。
OCR_ACCESS_KEY_ID=               # 留空 → 复用 OSS_ACCESS_KEY_ID
OCR_ACCESS_KEY_SECRET=           # 留空 → 复用 OSS_ACCESS_KEY_SECRET
OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
OCR_TYPE=General                 # General=通用印刷体基础版；Advanced=高精版
OCR_DPI=130                      # 扫描页渲染成 PNG 的 DPI（内部会按最长边封顶，避免超 10MB）
DM_HEADER_FOOTER_RATIO=0.6       # 同一文本在超过该比例页面重复即视为版式噪声
DM_QA_BATCH_SIZE=6               # 每批送 LLM 生成问答对的块数
DM_QA_PER_CHUNK=5                # 每个块期望生成的问答对上限（提示词会要求「尽可能多、多角度」生成）
DM_SEARCH_TOP_K=8                # 检索默认返回条数
DM_SEARCH_MIN_SIMILARITY=0.25    # 检索相似度下限
DM_MAX_PDF_BYTES=209715200       # PDF 体积上限（200MB）
DM_CACHE_DIR=                     # 本地 PDF 缓存目录，留空落到系统临时目录
